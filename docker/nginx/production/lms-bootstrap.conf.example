# Install this HTTP-only configuration before requesting the first certificate.
# Replace lms.example.com with the production hostname.

server {
  listen 80;
  listen [::]:80;
  server_name lms.example.com;

  access_log /var/log/nginx/lms-access.log;
  error_log /var/log/nginx/lms-error.log warn;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }

  location = /up {
    proxy_pass http://127.0.0.1:3001/up;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
  }

  location / {
    return 503;
  }
}
