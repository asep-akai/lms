{
    "ruby.useBundler": true,
    "ruby.pathToBundler": "/opt/homebrew/bin/bundle",
    "rubyLsp.formatter": "rubocop",
    "vscode-erb-beautify.executePath": "/opt/homebrew/lib/ruby/gems/4.0.0/bin/htmlbeautifier",
    "vscode-erb-beautify.customEnvVar": {
        "LC_ALL": "en_US.UTF-8"
    },
    "files.associations": {
        "*.html.erb": "erb",
        "manifest.json.erb": "json"
    },
    "[ruby]": {
        "editor.defaultFormatter": "Shopify.ruby-lsp",
        "editor.formatOnSave": true
    },
    "[erb]": {
        "editor.defaultFormatter": "aliariff.vscode-erb-beautify",
        "editor.formatOnSave": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/.rubymate": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
        "**/.rubymate": true
    }
}
