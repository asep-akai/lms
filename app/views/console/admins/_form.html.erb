<%= render "shared/errors", record: admin %><%= form_with model: [ :console, admin ], class: "form-stack" do |form| %><div class="form-grid"><div><%= form.label :name, class: "label" %><%= form.text_field :name, class: "field", required: true %></div><div><%= form.label :email, class: "label" %><%= form.email_field :email, class: "field", required: true %></div><div><%= form.label :status, class: "label" %><%= form.select :status, [[ "Active", "active" ], [ "Suspended", "suspended" ]], {}, class: "field" %></div></div><fieldset><legend class="label">Console roles</legend><div class="checkbox-grid"><% @roles.each do |role| %><label class="checkbox-row"><%= check_box_tag "admin[role_ids][]", role.id, admin.role_ids.include?(role.id) %><span><strong><%= role.name %></strong><span class="hint"><%= role.description %></span></span></label><% end %></div></fieldset><div class="actions"><%= form.submit class: "btn-primary" %><%= link_to "Cancel", console_admins_path, class: "btn-secondary" %></div><% end %>
