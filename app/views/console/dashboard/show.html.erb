<div class="page-header">
  <div>
    <p class="eyebrow">Platform</p>
    <h1 class="title">Console</h1>
    <p class="subtitle">Operate identities, organizations, and permission-based access.</p>
  </div>
</div>
<div class="stats">
  <div class="stat">
    <p class="stat-label">Organizations</p>
    <p class="stat-value">
      <%= @organization_count %>
    </p>
  </div>
  <div class="stat">
    <p class="stat-label">Users</p>
    <p class="stat-value">
      <%= @user_count %>
    </p>
  </div>
  <div class="stat">
    <p class="stat-label">Administrators</p>
    <p class="stat-value">
      <%= @admin_count %>
    </p>
  </div>
</div>
