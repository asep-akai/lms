<%= render "shared/errors", record: user %><%= form_with model: [ :console, user ], class: "form-stack" do |form| %><div class="form-grid"><div><%= form.label :name, class: "label" %><%= form.text_field :name, class: "field", required: true %></div><div><%= form.label :email, class: "label" %><%= form.email_field :email, class: "field", required: true %></div><div><%= form.label :status, class: "label" %><%= form.select :status, [[ "Active", "active" ], [ "Suspended", "suspended" ]], {}, class: "field" %></div></div><div class="actions"><%= form.submit class: "btn-primary" %><%= link_to "Cancel", console_users_path, class: "btn-secondary" %></div><% end %>
