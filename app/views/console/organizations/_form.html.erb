<%= render "shared/errors", record: organization %><%= form_with model: [ :console, organization ], class: "form-stack" do |form| %><div class="form-grid"><div><%= form.label :name, class: "label" %><%= form.text_field :name, class: "field", required: true %></div><div><%= form.label :slug, class: "label" %><%= form.text_field :slug, class: "field", required: true %></div><div><%= form.label :timezone, class: "label" %><%= form.time_zone_select :timezone, nil, {}, class: "field" %></div><div><%= form.label :locale, class: "label" %><%= form.select :locale, [[ "English", "en" ], [ "Bahasa Indonesia", "id" ]], {}, class: "field" %></div><% if organization.persisted? %><div><%= form.label :status, class: "label" %><%= form.select :status, [[ "Active", "active" ], [ "Suspended", "suspended" ]], {}, class: "field" %></div><% else %><div><%= label_tag "organization_owner_email", "Owner email", class: "label" %><%= email_field_tag "organization[owner_email]", params.dig(:organization, :owner_email), class: "field", required: true %><p class="hint">The owner must already have a user account.</p></div><% end %></div><div class="actions"><%= form.submit class: "btn-primary" %><%= link_to "Cancel", console_organizations_path, class: "btn-secondary" %></div><% end %>
