<div class="page-header">
  <div>
    <h1 class="title">Console roles</h1>
    <p class="subtitle">Policies authorize permission keys, never role names.</p>
  </div>
  <%= link_to "New role", new_console_role_path, class: "btn-primary" %>
</div>

<%= render "shared/table_search",
  url: console_roles_path,
  query: @query,
  label: "Search console roles",
  placeholder: "Search by name, key, or description" %>

<% if @roles.any? %>
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th class="th">Role</th>
        <th class="th">Permissions</th>
        <th class="th">Assignments</th>
        <th class="th">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @roles.each do |role| %>
        <tr>
          <td class="td">
            <strong>
              <%= role.name %>
            </strong>
            <br>
            <%= role.key %>
          </td>
          <td class="td">
            <%= role.permissions.count %>
          </td>
          <td class="td">
            <%= role.role_assignments.size %>
          </td>
          <td class="td">
            <% if role.editable? %>
              <%= link_to "Edit", edit_console_role_path(role), class: "text-link" %>
              <%= button_to "Delete", console_role_path(role), method: :delete, form: { data: { turbo_confirm: "Delete this role?" } }, class: "danger-link" %>
            <% else %>Protected<% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% elsif @query.present? %>
  <div class="empty-state">No console roles match “<%= @query %>”. Try another search or clear it.</div>
<% else %>
  <div class="empty-state">No console roles are available.</div>
<% end %>
