<%= render "shared/errors", record: role %>
<%= form_with model: [ :console, role ], class: "form-stack", data: { controller: "role-form", action: "submit->role-form#validate", role_form_existing_keys_value: @existing_role_keys } do |form| %>
  <div class="form-grid">
    <div>
      <%= form.label :name, class: "label" %>
      <%= form.text_field :name, class: "field", required: true %>
    </div>
    <div>
      <%= form.label :key, class: "label" %>
      <%= form.text_field :key,
        class: "field",
        required: true,
        pattern: "[a-z0-9]+(?:_[a-z0-9]+)*",
        title: "Use lowercase letters and numbers separated by single underscores.",
        aria: { describedby: "#{dom_id(role)}_key_help #{dom_id(role)}_key_error" },
        data: { role_form_target: "key", action: "input->role-form#validateKey" } %>
      <p id="<%= dom_id(role) %>_key_help" class="hint">Use lowercase letters, numbers, and underscores. For example: support_manager.</p>
      <p id="<%= dom_id(role) %>_key_error" class="field-error" data-role-form-target="keyError" role="alert" hidden></p>
    </div>
  </div>
  <div>
    <%= form.label :description, class: "label" %>
    <%= form.text_area :description, class: "field" %>
  </div>
  <%= render "shared/permission_groups", role: role, permission_groups: @permission_groups %>
  <div class="actions">
    <%= form.submit class: "btn-primary" %>
    <%= link_to "Cancel", console_roles_path, class: "btn-secondary" %>
  </div>
<% end %>
