<div class="auth-shell">
  <div class="auth-card">
    <p class="eyebrow">Platform administration</p>
    <h1 class="title">Console login</h1>
    <%= form_with model: resource, url: session_path(resource_name), class: "form-stack" do |form| %>
      <div>
        <%= form.label :email, class: "label" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "field" %>
      </div>
      <div>
        <%= form.label :password, class: "label" %>
        <%= form.password_field :password, autocomplete: "current-password", class: "field" %>
      </div>
      <%= form.submit "Sign in to console", class: "btn-primary" %>
      <%= link_to "Forgot password?", new_admin_password_path, class: "text-link" %>
    <% end %>
  </div>
</div>
