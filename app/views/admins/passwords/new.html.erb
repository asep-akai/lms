<div class="auth-shell">
  <div class="auth-card">
    <h1 class="title">Reset console password</h1>
    <%= form_with model: resource, url: password_path(resource_name), class: "form-stack" do |form| %>
      <div>
        <%= form.label :email, class: "label" %>
        <%= form.email_field :email, autofocus: true, class: "field" %>
      </div>
      <%= form.submit "Send instructions", class: "btn-primary" %>
    <% end %>
  </div>
</div>
