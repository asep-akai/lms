<div class="auth-shell"><div class="auth-card"><h1 class="title">Choose a console password</h1><%= form_with model: resource, url: password_path(resource_name), method: :put, class: "form-stack" do |form| %><%= form.hidden_field :reset_password_token %><%= render "shared/errors", record: resource %><div><%= form.label :password, class: "label" %><%= form.password_field :password, autofocus: true, class: "field" %></div><div><%= form.label :password_confirmation, class: "label" %><%= form.password_field :password_confirmation, class: "field" %></div><%= form.submit "Save password", class: "btn-primary" %><% end %></div></div>
