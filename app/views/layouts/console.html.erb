<!DOCTYPE html>
<html>
  <head>
    <title>
      <%= content_for(:title) || "LMS Console" %>
    </title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="topbar" data-controller="mobile-navigation" data-action="click@document->mobile-navigation#outside keydown.esc@document->mobile-navigation#escape turbo:before-cache@document->mobile-navigation#close">
      <div class="topbar-inner">
        <div class="topbar-navigation">
          <%= link_to "LMS Console", console_root_path, class: "brand" %>
          <button type="button" class="navigation-toggle" aria-expanded="false" aria-controls="primary-navigation" data-mobile-navigation-target="toggle" data-action="mobile-navigation#toggle">Menu</button>
          <nav id="primary-navigation" class="nav" aria-label="Main navigation" data-mobile-navigation-target="menu">
            <%= link_to "Organizations", console_organizations_path, class: "nav-link" %>
            <%= link_to "Users", console_users_path, class: "nav-link" %>
            <%= link_to "Administrators", console_admins_path, class: "nav-link" %>
            <%= link_to "Roles", console_roles_path, class: "nav-link" %>
            <% if current_admin.can?("website.edit") || current_admin.can?("website.publish") %><%= link_to "Website", console_website_path, class: "nav-link" %><% end %>
            <% if current_admin.can?("support_tickets.console") %><%= link_to "Support", console_support_tickets_path, class: "nav-link" %><% end %>
          </nav>
        </div>
        <%= button_to "Sign out", destroy_admin_session_path, method: :delete, class: "nav-link" %>
      </div>
    </header>
    <main class="page">
      <% flash.each do |type, message| %>
        <div class="<%= type.to_s == "alert" ? "alert-error" : "alert-success" %>">
          <%= message %>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <%= turbo_frame_tag "modal" %>
  </body>
</html>
