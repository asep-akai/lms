<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "LMS Console" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <div class="actions">
          <%= link_to "LMS Console", console_root_path, class: "brand" %>
          <nav class="nav">
            <%= link_to "Organizations", console_organizations_path, class: "nav-link" %>
            <%= link_to "Users", console_users_path, class: "nav-link" %>
            <%= link_to "Administrators", console_admins_path, class: "nav-link" %>
            <%= link_to "Roles", console_roles_path, class: "nav-link" %>
          </nav>
        </div>
        <%= button_to "Sign out", destroy_admin_session_path, method: :delete, class: "nav-link" %>
      </div>
    </header>
    <main class="page">
      <% flash.each do |type, message| %><div class="<%= type.to_s == "alert" ? "alert-error" : "alert-success" %>"><%= message %></div><% end %>
      <%= yield %>
    </main>
    <%= turbo_frame_tag "modal" %>
  </body>
</html>
