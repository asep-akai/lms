<% if record.errors.any? %>
  <div class="alert-error">
    <strong>
      <%= pluralize(record.errors.count, "error") %>
      prevented this from being saved:</strong>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li>
          <%= message %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
