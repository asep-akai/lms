<div class="page-header">
  <div>
    <h1 class="title">Roles</h1>
    <p class="subtitle">Permission-based access inside <%= current_organization.name %>.</p>
  </div>
  <div class="actions">
    <%= back_link_to "Back to organization", organization_path(current_organization) %>
    <% if can?("roles.create") %>
      <%= modal_link_to "New custom role", new_organization_role_path(current_organization), class: "btn-primary" %>
    <% end %>
  </div>
</div>
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th class="th">Role</th>
        <th class="th">Permissions</th>
        <th class="th">Members</th>
        <th class="th">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @roles.each do |role| %>
        <tr>
          <td class="td">
            <strong>
              <%= role.name %>
            </strong>
            <br>
            <%= role.key %>
          </td>
          <td class="td">
            <%= role.permissions.map(&:name).to_sentence.presence || "None" %>
          </td>
          <td class="td">
            <%= role.memberships.count %>
          </td>
          <td class="td">
            <% if policy(role).update? %>
              <%= modal_link_to "Edit", edit_organization_role_path(current_organization, role), class: "text-link" %>
            <% else %>Protected<% end %>
            <% if policy(role).destroy? %>
              <%= button_to(
                "Delete",
                organization_role_path(current_organization, role),
                method: :delete,
                form: { data: { turbo_confirm: "Delete this role?" } },
                class: "danger-link"
              ) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
