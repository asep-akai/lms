<p class="text-sm font-medium text-slate-500">Question <%= question.position %> · <%= question.question_type.humanize %></p>
<% if question.content_text? %>
  <div id="active-question-heading" class="rich-content mt-3 text-slate-950"><%= sanitize(question.content_html, tags: QuizQuestion::ALLOWED_HTML_TAGS, attributes: []) %></div>
<% end %>
