<% content_for :title, @ticket.subject %>
<%= back_link_to "Back to support", organization_support_tickets_path(Current.organization) %>

<header class="mt-6">
  <p class="eyebrow">Support ticket #<%= @ticket.id %></p>
  <h1 class="title"><%= @ticket.subject %></h1>
  <div class="mt-3 flex flex-wrap gap-2">
    <span class="<%= support_status_badge_class(@ticket.status) %>"><%= @ticket.status.humanize %></span>
    <span class="<%= support_priority_badge_class(@ticket.priority) %>"><%= @ticket.priority.humanize %> priority</span>
    <% if @ticket.escalated? %><span class="badge-info">Escalated to console</span><% end %>
  </div>
</header>

<div class="support-layout">
  <%= render "support_tickets/conversation", ticket: @ticket, messages: @messages, timezone: Current.organization.timezone,
    reply_url: reply_organization_support_ticket_path(Current.organization, @ticket), message_errors: @message&.errors,
    attachment_path: ->(attachment) { attachment_organization_support_ticket_path(Current.organization, @ticket, attachment_id: attachment.id) } %>

  <aside class="support-sidebar" aria-label="Ticket details and actions">
    <section class="card card-body">
      <h2>Ticket details</h2>
      <dl class="support-detail-list mt-4">
        <div class="support-detail-row"><dt class="text-slate-500">Reporter</dt><dd class="text-right font-medium"><%= @ticket.reporter_membership.user.name %></dd></div>
        <div class="support-detail-row"><dt class="text-slate-500">Category</dt><dd class="text-right font-medium"><%= @ticket.category.humanize %></dd></div>
        <div class="support-detail-row"><dt class="text-slate-500">Created</dt><dd class="text-right font-medium"><%= l @ticket.created_at.in_time_zone(Current.organization.timezone), format: :short %></dd></div>
        <div class="support-detail-row"><dt class="text-slate-500">Last activity</dt><dd class="text-right font-medium"><%= l @ticket.updated_at.in_time_zone(Current.organization.timezone), format: :short %></dd></div>
      </dl>
    </section>

    <% if policy(@ticket).update? %>
      <section class="card card-body">
        <h2>Manage ticket</h2>
        <%= form_with model: @ticket, url: organization_support_ticket_path(Current.organization, @ticket), method: :patch, class: "form-stack mt-4" do |form| %>
          <div><%= form.label :status, class: "label" %><%= form.select :status, SupportTicket::STATUSES.map { |value| [ value.humanize, value ] }, {}, class: "field" %></div>
          <%= form.submit "Update status", class: "btn-secondary w-full" %>
        <% end %>
        <% if policy(@ticket).escalate? %>
          <div class="mt-5 border-t border-slate-200 pt-5">
            <p class="mb-3 text-sm text-slate-600">Send this ticket and its conversation to console support.</p>
            <%= button_to "Escalate to console", escalate_organization_support_ticket_path(Current.organization, @ticket), method: :patch, class: "btn-primary w-full", form: { data: { turbo_confirm: "Escalate this ticket to console support?" } } %>
          </div>
        <% end %>
      </section>
    <% end %>
  </aside>
</div>
