<section class="mt-8" aria-labelledby="<%= title.parameterize %>-heading">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="<%= title.parameterize %>-heading"><%= title %></h2>
      <% if description.present? %>
        <p class="subtitle"><%= description %></p>
      <% end %>
    </div>
    <% if actions.any? %>
      <div class="actions">
        <% actions.each do |action| %>
          <%= link_to action[:label], action[:path], class: "btn-secondary" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if course_contents.any? %>
    <ol class="mt-4 space-y-4">
      <% course_contents.each_with_index do |course_content, index| %>
        <li id="course-content-<%= course_content.id %>">
          <%= render(
            course_content.material? ? "organizations/courses/material_card" : "organizations/courses/quiz_card",
            item: course_content.contentable,
            course_content: course_content,
            module_number: index + 1,
            first: index.zero?,
            last: index == course_contents.length - 1
          ) %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <div class="empty-state"><%= empty_message %></div>
  <% end %>
</section>
