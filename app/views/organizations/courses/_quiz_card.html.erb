<% attempt = @quiz_attempts&.[](item.id) %>
<% module_number = local_assigns[:module_number] %>
<div class="card card-body flex flex-col">
  <div class="flex items-start justify-between gap-3">
    <div>
      <% if module_number %>
        <p class="text-sm font-medium text-brand-700">Module <%= module_number %> · Quiz</p>
      <% end %>
      <h3 class="<%= module_number ? "mt-1" : "" %> font-semibold text-slate-950"><%= item.title %></h3>
    </div>
    <div class="flex flex-col items-end gap-3">
      <% unless policy(item).update? %>
        <% if attempt&.reviewed? %>
          <span class="badge-neutral">Reviewed</span>
        <% elsif attempt&.submitted? %>
          <span class="badge-suspended">In review</span>
        <% elsif attempt %>
          <span class="badge-active">In progress</span>
        <% else %>
          <span class="badge-neutral">Not started</span>
        <% end %>
      <% end %>
      <% if local_assigns[:course_content] %>
        <%= render "organizations/courses/content_order_controls",
          course_content: course_content,
          module_number: module_number,
          first: first,
          last: last %>
      <% end %>
    </div>
  </div>
  <% if item.description.present? %>
    <p class="subtitle"><%= truncate(item.description, length: 180) %></p>
  <% end %>
  <p class="mt-4 text-sm text-slate-500"><%= pluralize(item.questions.size, "question") %></p>
  <div class="actions mt-auto pt-5">
    <% if policy(item).update? %>
      <%= link_to "Manage quiz", organization_course_quiz_path(current_organization, @course, item, from: module_number ? "course" : nil), class: "btn-secondary" %>
    <% end %>
    <% unless policy(item).update? %>
      <%= link_to "View quiz", organization_course_quiz_path(current_organization, @course, item, from: "course"), class: "btn-primary" %>
    <% end %>
  </div>
</div>
