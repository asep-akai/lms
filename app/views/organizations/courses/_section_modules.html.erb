<% if course_contents.any? %>
  <ol class="space-y-4">
    <% course_contents.each_with_index do |course_content, index| %>
      <% module_number = index + 1 %>
      <% student_progress = @course_progress&.fetch([ course_content.course_id, current_membership.id ], nil) if current_membership&.student? %>
      <li id="course-content-<%= course_content.id %>">
        <%= render(
          course_content.material? ? "organizations/courses/material_card" : "organizations/courses/quiz_card",
          item: course_content.contentable,
          course_content: course_content,
          module_number: module_number,
          completed: student_progress&.completed?(course_content),
          first: index.zero?,
          last: index == course_contents.length - 1
        ) %>
      </li>
    <% end %>
  </ol>
<% else %>
  <div class="empty-state mt-4">No modules are in this section yet.</div>
<% end %>
