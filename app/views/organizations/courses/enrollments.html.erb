<div class="page-header">
  <div>
    <p class="eyebrow">Course</p>
    <h1 class="title">Manage students</h1>
    <p class="subtitle"><%= @course.name %></p>
  </div>
  <%= back_link_to "Back to course", organization_course_path(current_organization, @course) %>
</div>
<%= render "shared/errors", record: @course %>
<%= form_with url: enrollments_organization_course_path(current_organization, @course), method: :patch, class: "form-stack mt-8" do %>
  <%= render "shared/searchable_student_multiselect",
    students: @students,
    selected_student_ids: @enrolled_membership_ids,
    field_name: "course[membership_ids]",
    id_prefix: "course-enrollment",
    legend: "Enrolled students",
    hint: "Select every student who should have access to this course.",
    empty_message: "There are no active students in this organization." %>
  <div class="actions">
    <%= submit_tag "Save enrollments", class: "btn-primary", disabled: @students.empty? %>
    <%= link_to "Cancel", organization_course_path(current_organization, @course), class: "btn-secondary" %>
  </div>
<% end %>
