<div class="page-header"><div><p class="eyebrow">Organization</p><h1 class="title"><%= @organization.name %></h1><p class="subtitle">Administration and access control.</p></div><% if can?("organization.update") %><%= link_to "Settings", edit_organization_path(@organization), class: "btn-secondary" %><% end %></div>
<div class="stats"><div class="stat"><p class="stat-label">Members</p><p class="stat-value"><%= @organization.memberships.count %></p></div><div class="stat"><p class="stat-label">Active members</p><p class="stat-value"><%= @organization.memberships.active.count %></p></div><div class="stat"><p class="stat-label">Roles</p><p class="stat-value"><%= @organization.roles.count %></p></div><div class="stat"><p class="stat-label">Timezone</p><p class="subtitle"><%= @organization.timezone %></p></div></div>
<div class="stats"><% if can?("memberships.index") %><%= link_to "Manage members", organization_memberships_path(@organization), class: "card-link" %><% end %><% if can?("roles.index") %><%= link_to "Manage roles", organization_roles_path(@organization), class: "card-link" %><% end %><% if can?("audit_events.index") %><%= link_to "Review audit log", organization_audit_events_path(@organization), class: "card-link" %><% end %></div>
