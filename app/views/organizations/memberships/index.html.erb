<div class="page-header">
  <div>
    <h1 class="title">Members</h1>
    <p class="subtitle">Membership and role assignments for <%= current_organization.name %>.</p>
  </div>
  <div class="actions">
    <%= back_link_to "Back to organization", organization_path(current_organization) %>
    <% if can?("memberships.create") %>
      <%= link_to "Add member", new_organization_membership_path(current_organization), class: "btn-primary" %>
    <% end %>
  </div>
</div>
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th class="th">Member</th>
        <th class="th">Roles</th>
        <th class="th">Status</th>
        <th class="th">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @memberships.each do |membership| %>
        <tr>
          <td class="td">
            <strong>
              <%= membership.user.name %>
            </strong>
            <br>
            <%= membership.user.email %>
          </td>
          <td class="td">
            <%= membership.roles.map(&:name).to_sentence.presence || "No role" %>
          </td>
          <td class="td">
            <span class="<%= status_badge_class(membership.status) %>">
              <%= membership.status.titleize %>
            </span>
          </td>
          <td class="td">
            <% if policy(membership).update? %>
              <%= link_to "Edit", edit_organization_membership_path(current_organization, membership), class: "text-link" %>
            <% end %>
            <% if policy(membership).destroy? %>
              <%= button_to(
                "Remove",
                organization_membership_path(current_organization, membership),
                method: :delete,
                form: { data: { turbo_confirm: "Remove this member?" } },
                class: "danger-link"
              ) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
