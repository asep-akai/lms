<h1 class="title">Edit membership</h1><p class="subtitle"><%= @membership.user.name %> · <%= @membership.user.email %></p><%= render "shared/errors", record: @membership %><%= form_with model: [ current_organization, @membership ], class: "form-stack" do |form| %><div><%= form.label :status, class: "label" %><%= form.select :status, [[ "Active", "active" ], [ "Suspended", "suspended" ]], {}, class: "field" %></div><%= render "role_fields", membership: @membership %><div class="actions"><%= form.submit "Save membership", class: "btn-primary" %><%= link_to "Cancel", organization_memberships_path(current_organization), class: "btn-secondary" %></div><% end %>
