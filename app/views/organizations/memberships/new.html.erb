<div class="page-header">
  <div>
    <h1 class="title">Add member</h1>
    <p class="subtitle">Set an initial password when the email belongs to a new LMS user.</p>
  </div>
  <%= back_link_to "Back to members", organization_memberships_path(current_organization) %>
</div>
<%= render "shared/errors", record: @membership %>
<%= form_with scope: :membership, url: organization_memberships_path(current_organization), class: "form-stack" do |form| %>
  <div class="form-grid">
    <div>
      <%= form.label :name, class: "label" %>
      <%= form.text_field :name, required: true, class: "field" %>
    </div>
    <div>
      <%= form.label :email, class: "label" %>
      <%= form.email_field :email, required: true, class: "field" %>
    </div>
    <div>
      <%= form.label :password, "Initial password", class: "label" %>
      <%= form.password_field :password, class: "field", autocomplete: "new-password" %>
      <p class="hint">Required for a new user. An existing user keeps their current password.</p>
    </div>
    <div>
      <%= form.label :password_confirmation, "Confirm initial password", class: "label" %>
      <%= form.password_field :password_confirmation, class: "field", autocomplete: "new-password" %>
    </div>
  </div>
  <%= render "role_fields", membership: @membership %>
  <div class="actions">
    <%= form.submit "Add member", class: "btn-primary" %>
    <%= link_to "Cancel", organization_memberships_path(current_organization), class: "btn-secondary" %>
  </div>
<% end %>
