<h1 class="title">Add member</h1><p class="subtitle">New users receive an email link to set their password.</p><%= render "shared/errors", record: @membership %><%= form_with scope: :membership, url: organization_memberships_path(current_organization), class: "form-stack" do |form| %><div class="form-grid"><div><%= form.label :name, class: "label" %><%= form.text_field :name, required: true, class: "field" %></div><div><%= form.label :email, class: "label" %><%= form.email_field :email, required: true, class: "field" %></div></div><%= render "role_fields", membership: @membership %><div class="actions"><%= form.submit "Add member", class: "btn-primary" %><%= link_to "Cancel", organization_memberships_path(current_organization), class: "btn-secondary" %></div><% end %>
