<section class="card card-body mt-8" aria-labelledby="submission-heading">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="eyebrow">Your work</p>
      <h2 id="submission-heading" class="mt-1">Submission</h2>
    </div>
    <% if assignment.cancelled? %>
      <span class="badge-neutral">Cancelled</span>
    <% elsif submission.submitted? %>
      <span class="<%= submission.late? ? "badge-suspended" : "badge-active" %>"><%= submission.late? ? "Submitted late" : "Submitted" %></span>
    <% elsif recipient.overdue? %>
      <span class="badge-suspended">Late</span>
    <% else %>
      <span class="badge-neutral">Draft</span>
    <% end %>
  </div>

  <% if assignment.cancelled? %>
    <p class="mt-4 text-sm text-slate-600">This assignment is cancelled. You cannot submit or change your work.</p>
    <% if submission.persisted? %>
      <% if submission.body.present? %><p class="mt-5 whitespace-pre-wrap text-slate-800"><%= submission.body %></p><% end %>
      <%= render "organizations/assignments/submission_documents", assignment: assignment, submission: submission %>
      <% if submission.teacher_comment.present? %>
        <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4">
          <p class="label">Teacher comment</p>
          <p class="mt-2 whitespace-pre-wrap text-slate-800"><%= submission.teacher_comment %></p>
        </div>
      <% end %>
    <% else %>
      <p class="mt-4 text-sm text-slate-600">No work was saved before the assignment was cancelled.</p>
    <% end %>
  <% elsif submission.submitted? %>
    <p class="mt-4 text-sm text-slate-600">Submitted <%= submission.submitted_at.in_time_zone(current_organization.timezone).strftime("%-d %B %Y at %H:%M %Z") %>. Submitted work cannot be changed.</p>
    <% if submission.body.present? %><p class="mt-5 whitespace-pre-wrap text-slate-800"><%= submission.body %></p><% end %>
    <%= render "organizations/assignments/submission_documents", assignment: assignment, submission: submission %>
    <% if submission.teacher_comment.present? %>
      <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4">
        <p class="label">Teacher comment</p>
        <p class="mt-2 whitespace-pre-wrap text-slate-800"><%= submission.teacher_comment %></p>
      </div>
    <% end %>
  <% else %>
    <%= form_with model: submission, url: organization_assignment_submission_path(current_organization, assignment), method: :patch, class: "mt-6 space-y-5" do |form| %>
      <% if submission.errors.any? %>
        <div class="alert-error"><%= submission.errors.full_messages.to_sentence %></div>
      <% end %>
      <div>
        <%= form.label :body, "Written response", class: "label" %>
        <%= form.text_area :body, rows: 9, class: "field", maxlength: 30_000 %>
      </div>
      <div>
        <%= form.label :documents, "Documents", class: "label" %>
        <%= form.file_field :documents, multiple: true, accept: Assignment::ALLOWED_DOCUMENT_TYPES.join(","), class: "field" %>
        <p class="hint">New uploads are added to your saved documents. You do not need to select saved files again. Each file must be 20 MB or smaller.</p>
      </div>
      <%= render "organizations/assignments/submission_documents", assignment: assignment, submission: submission %>
      <div class="actions">
        <%= form.submit "Save draft", class: "btn-secondary" %>
        <%= form.button "Submit assignment",
          type: :submit,
          name: "submit_assignment",
          value: "1",
          class: "btn-primary",
          data: { turbo_confirm: "Submit this assignment? You will not be able to change it afterward." } %>
      </div>
    <% end %>
  <% end %>
</section>
