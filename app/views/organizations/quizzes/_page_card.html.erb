<div class="p-5 sm:p-6" data-controller="question-card">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="min-w-0">
      <h3 id="quiz-page-<%= page.id %>" class="text-lg font-semibold text-slate-950"><%= page.title %></h3>
      <% if page.blocks.any? %><div class="mt-4"><%= render "organizations/quizzes/page_content", page: page %></div><% else %><p class="mt-2 text-sm text-slate-500">No shared content.</p><% end %>
    </div>
    <div class="actions shrink-0">
      <%= button_to "Move up", move_organization_course_quiz_page_path(current_organization, course, quiz, page, direction: "up", from: params[:from]), method: :patch, class: "btn-secondary", disabled: page == quiz.pages.first %>
      <%= button_to "Move down", move_organization_course_quiz_page_path(current_organization, course, quiz, page, direction: "down", from: params[:from]), method: :patch, class: "btn-secondary", disabled: page == quiz.pages.last %>
      <button type="button" class="btn-secondary" data-action="question-card#toggle" data-question-card-target="toggle" data-closed-label="Edit page">Edit page</button>
    </div>
  </div>
  <div class="mt-5" data-question-card-target="editor" hidden>
    <%= render "organizations/quizzes/page_form", page: page, quiz: quiz, course: course, heading: "Edit page" %>
    <% if quiz.pages.size > 1 %><div class="mt-3"><%= button_to "Remove page", organization_course_quiz_page_path(current_organization, course, quiz, page, from: params[:from]), method: :delete, form: { data: { turbo_confirm: "Remove this empty page?" } }, class: "danger-link", disabled: page.questions.exists? %></div><% end %>
  </div>
</div>
