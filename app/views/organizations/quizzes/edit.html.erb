<div class="page-header"><div><p class="eyebrow"><%= @course.name %> · Quiz editor</p><h1 class="title"><%= @quiz.title %></h1><% if @quiz.description.present? %><p class="subtitle"><%= @quiz.description %></p><% end %></div><div class="actions"><%= link_to "View quiz", organization_course_quiz_path(current_organization, @course, @quiz), class: "btn-secondary" %><%= back_link_to "Back to quizzes", organization_course_quizzes_path(current_organization, @course) %></div></div>
<section class="card card-body mt-8" data-controller="question-card"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2>Quiz details</h2><p class="hint">Title and description are saved separately from questions.</p></div><button type="button" class="btn-secondary" data-action="question-card#toggle" data-question-card-target="toggle" data-closed-label="Edit details">Edit details</button></div><div class="mt-5" data-question-card-target="editor" hidden><%= render "organizations/quizzes/details_form", quiz: @quiz, course: @course %></div></section>
<section class="mt-8" data-controller="question-card"><div class="flex flex-wrap items-end justify-between gap-3"><div><h2>Questions</h2><p class="hint">Open a question only when you need to change it. Each save affects that question alone.</p></div><button type="button" class="btn-primary" data-action="question-card#toggle" data-question-card-target="toggle" data-closed-label="Add question">Add question</button></div><div class="mt-4" data-question-card-target="editor" hidden><%= render "organizations/quizzes/question_form", question: @new_question, quiz: @quiz, course: @course, heading: "New question" %></div><div class="mt-4 space-y-4"><% @questions.each do |question| %><%= render "organizations/quizzes/question_card", question: question, quiz: @quiz, course: @course %><% end %></div><% if @questions.empty? %><div class="empty-state">No questions yet. Add the first question to begin building this quiz.</div><% end %></section>
