<div class="page-header">
  <div>
    <p class="eyebrow"><%= @course.name %> · Quiz editor</p>
    <h1 class="title"><%= @quiz.title %></h1>
    <% if @quiz.description.present? %><p class="subtitle"><%= @quiz.description %></p><% end %>
  </div>
  <div class="actions">
    <%= link_to "View quiz", organization_course_quiz_path(current_organization, @course, @quiz, from: params[:from]), class: "btn-secondary" %>
    <% if params[:from] == "course" %>
      <%= back_link_to "Back to course", organization_course_path(current_organization, @course) %>
    <% else %>
      <%= back_link_to "Back to quizzes", organization_course_quizzes_path(current_organization, @course) %>
    <% end %>
  </div>
</div>

<%= render "shared/errors", record: @quiz %>
<section class="card card-body mt-8" data-controller="question-card">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div><h2>Quiz details</h2><p class="hint">Title, description, time limit, and retake settings are saved separately.</p></div>
    <button type="button" class="btn-secondary" data-action="question-card#toggle" data-question-card-target="toggle" data-closed-label="Edit details">Edit details</button>
  </div>
  <div class="mt-5" data-question-card-target="editor" hidden><%= render "organizations/quizzes/details_form", quiz: @quiz, course: @course %></div>
</section>

<section class="mt-8" data-controller="question-card">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div><h2>Pages</h2><p class="hint">A page groups questions under shared instructions. Students see those instructions beside every question on the page.</p></div>
    <button type="button" class="btn-secondary" data-action="question-card#toggle" data-question-card-target="toggle" data-closed-label="Add page">Add page</button>
  </div>
  <div class="mt-4" data-question-card-target="editor" hidden><%= render "organizations/quizzes/page_form", page: @new_page, quiz: @quiz, course: @course, heading: "New page" %></div>
</section>

<section class="mt-8" data-controller="question-card">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div><h2>Questions</h2><p class="hint">Questions are shown in page order. Each question is saved independently.</p></div>
    <button type="button" class="btn-primary" data-action="question-card#toggle" data-question-card-target="toggle" data-closed-label="Add question">Add question</button>
  </div>
  <div class="mt-4" data-question-card-target="editor" hidden><%= render "organizations/quizzes/question_form", question: @new_question, quiz: @quiz, course: @course, pages: @pages, heading: "New question" %></div>
  <div class="mt-6 space-y-6">
    <% @pages.each do |page| %>
      <section class="rounded-xl border border-slate-300 bg-white shadow-sm" aria-labelledby="quiz-page-<%= page.id %>">
        <%= render "organizations/quizzes/page_card", page: page, quiz: @quiz, course: @course %>
        <div class="space-y-4 border-t border-slate-200 bg-slate-50 p-4 sm:p-6">
          <% page.questions.each do |question| %>
            <%= render "organizations/quizzes/question_card", question: question, quiz: @quiz, course: @course, pages: @pages %>
          <% end %>
          <% if page.questions.empty? %><p class="rounded-lg border border-dashed border-slate-300 bg-white p-5 text-center text-sm text-slate-500">No questions on this page yet.</p><% end %>
        </div>
      </section>
    <% end %>
  </div>
</section>
