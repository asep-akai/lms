<section class="card card-body" data-controller="question-card"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-sm font-medium text-slate-500">Question <%= question.position %> · <%= question.question_type.humanize %></p><div class="rich-content mt-2 text-slate-800"><%= sanitize(question.content_html, tags: QuizQuestion::ALLOWED_HTML_TAGS, attributes: []) %></div></div><div class="actions"><%= button_to "Move up", move_organization_course_quiz_question_path(current_organization, course, quiz, question, direction: "up"), method: :patch, class: "btn-secondary", disabled: question.position == 1 %><%= button_to "Move down", move_organization_course_quiz_question_path(current_organization, course, quiz, question, direction: "down"), method: :patch, class: "btn-secondary", disabled: question.position == quiz.questions.maximum(:position) %><button type="button" class="btn-secondary" data-action="question-card#toggle" data-question-card-target="toggle" data-closed-label="Edit question">Edit question</button></div></div><div class="mt-5" data-question-card-target="editor" hidden><%= render "organizations/quizzes/question_form", question: question, quiz: quiz, course: course, heading: "Edit question" %></div></section>
