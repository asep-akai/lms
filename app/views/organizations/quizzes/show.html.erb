<div class="page-header">
  <div>
    <p class="eyebrow"><%= @course.name %> · Quiz</p>
    <h1 class="title"><%= @quiz.title %></h1>
    <% if @quiz.description.present? %>
      <p class="subtitle"><%= @quiz.description %></p>
    <% end %>
  </div>
  <div class="actions">
    <% if params[:from] == "course" %>
      <%= back_link_to "Back to course", organization_course_path(current_organization, @course) %>
    <% else %>
      <%= back_link_to "Back to quizzes", organization_course_quizzes_path(current_organization, @course) %>
    <% end %>
    <% if policy(@quiz).update? %>
      <%= link_to "Edit quiz", edit_organization_course_quiz_path(current_organization, @course, @quiz, from: params[:from]), class: "btn-primary" %>
    <% end %>
  </div>
</div>

<% if policy(@quiz).update? %>
  <section class="card card-body mt-8" aria-labelledby="quiz-settings-heading">
    <p class="eyebrow">Attempt settings</p>
    <h2 id="quiz-settings-heading" class="mt-1">Quiz rules</h2>
    <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-medium text-slate-500">Retakes</dt>
        <dd class="mt-1 text-slate-950"><%= @quiz.retake_limit.to_i.positive? ? pluralize(@quiz.retake_limit, "retake") : "Not allowed" %></dd>
      </div>
      <div>
        <dt class="font-medium text-slate-500">Time limit</dt>
        <dd class="mt-1 text-slate-950"><%= @quiz.time_limited? ? pluralize(@quiz.time_limit_minutes, "minute") : "No time limit" %></dd>
      </div>
    </dl>
  </section>

  <div class="mt-8 space-y-6">
    <% @quiz.pages.includes({ blocks: { image_attachment: :blob } }, questions: :answer_options).each do |page| %>
      <section class="rounded-xl border border-slate-300 bg-white shadow-sm">
        <div class="p-5 sm:p-6">
          <h2><%= page.title %></h2>
          <% if page.blocks.any? %><div class="mt-4"><%= render "organizations/quizzes/page_content", page: page %></div><% end %>
        </div>
        <div class="space-y-4 border-t border-slate-200 bg-slate-50 p-4 sm:p-6">
          <% page.questions.each do |question| %>
            <section class="card card-body">
              <p class="text-sm font-medium text-slate-500">Question <%= question.position %> · <%= question.question_type.humanize %></p>
              <% if question.content_text? %><div class="rich-content mt-3 text-slate-800"><%= sanitize(question.content_html, tags: QuizQuestion::ALLOWED_HTML_TAGS, attributes: []) %></div><% end %>

              <% if question.multiple_choice? || question.multiple_choice_set? %>
                <ul class="mt-4 space-y-2">
                  <% question.answer_options.each do |option| %>
                    <li class="rounded-lg border border-slate-200 px-4 py-3 text-sm <%= option.correct? ? "border-emerald-300 bg-emerald-50 text-emerald-900" : "text-slate-700" %>">
                      <%= option.content %><% if option.correct? %><span class="ml-2 font-medium">Correct</span><% end %>
                    </li>
                  <% end %>
                </ul>
              <% elsif question.short_answer? %>
                <p class="mt-4 text-sm text-slate-600"><span class="font-medium">Expected answer:</span> <%= question.short_answer %></p>
              <% elsif question.cloze? %>
                <div class="mt-4 text-sm text-slate-600">
                  <span class="font-medium">Expected answers:</span>
                  <%= render "organizations/quiz_answers/answer_key", question: question %>
                </div>
              <% elsif question.essay? %>
                <p class="mt-4 text-sm text-slate-500"><%= question.feedback_only? ? "Essay response · Feedback only" : "Essay response · Included in final score" %></p>
              <% else %>
                <p class="mt-4 text-sm text-slate-500"><%= question.feedback_only? ? "Audio response · Feedback only" : "Audio response · Included in final score" %></p>
              <% end %>
            </section>
          <% end %>
          <% if page.questions.empty? %><p class="text-sm text-slate-500">No questions on this page.</p><% end %>
        </div>
      </section>
    <% end %>
  </div>

  <% if policy(@quiz).destroy? %>
    <div class="mt-8">
      <%= button_to "Delete quiz", organization_course_quiz_path(current_organization, @course, @quiz, from: params[:from]), method: :delete, form: { data: { turbo_confirm: "Delete this quiz and all of its questions?" } }, class: "btn-danger" %>
    </div>
  <% end %>
<% else %>
  <section class="card card-body mt-8" aria-labelledby="quiz-status-heading">
    <div class="mb-5 border-b border-slate-200 pb-4 text-sm">
      <span class="font-medium text-slate-600">Retakes:</span>
      <strong class="ml-1 text-slate-950">
        <% if @quiz.retake_limit.to_i.positive? %>
          <%= @remaining_retakes %> of <%= @quiz.retake_limit %> remaining
        <% else %>
          Not allowed
        <% end %>
      </strong>
    </div>
    <% if @attempt&.reviewed? %>
      <p class="eyebrow">Results published</p>
      <h2 id="quiz-status-heading" class="mt-1">Your result is ready</h2>
      <p class="subtitle">Your answers have been graded and are available to review.</p>
      <div class="actions mt-5">
        <%= link_to "View results", organization_evaluation_attempt_path(current_organization, @attempt, from: "quiz"), class: "btn-primary" %>
        <% if @remaining_retakes.positive? %>
          <%= render "connection_check",
            label: "Start retake",
            destination: retake_organization_course_quiz_path(current_organization, @course, @quiz),
            method: :post,
            confirm: "Start a new attempt? Your current result will be cancelled and hidden from your evaluation history." %>
        <% end %>
      </div>
      <%= render "attempt_rules", quiz: @quiz if @remaining_retakes.positive? %>
    <% elsif @attempt&.submitted? %>
      <p class="eyebrow"><%= @attempt.timed_out? ? "Time ended" : "In review" %></p>
      <h2 id="quiz-status-heading" class="mt-1"><%= @attempt.timed_out? ? "Attempt submitted when time ran out" : "Attempt submitted" %></h2>
      <p class="subtitle">Your saved answers are waiting for review.</p>
      <% if @remaining_retakes.positive? %>
        <div class="actions mt-5">
          <%= render "connection_check",
            label: "Start retake",
            destination: retake_organization_course_quiz_path(current_organization, @course, @quiz),
            method: :post,
            confirm: "Start a new attempt? Your current attempt will be cancelled and hidden from your evaluation history." %>
        </div>
        <%= render "attempt_rules", quiz: @quiz %>
      <% end %>
    <% elsif @attempt %>
      <p class="eyebrow">In progress</p>
      <h2 id="quiz-status-heading" class="mt-1">Continue your attempt</h2>
      <p class="subtitle"><%= @attempt.expires_at? ? "The timer is still running. You will return to the last question you visited." : "You will return to the last question you visited." %></p>
      <div class="actions mt-5">
        <%= render "connection_check",
          label: "Resume quiz",
          destination: attempt_organization_course_quiz_path(current_organization, @course, @quiz, attempt_id: @attempt.id) %>
      </div>
    <% elsif @quiz.questions.any? %>
      <p class="eyebrow">Not started</p>
      <h2 id="quiz-status-heading" class="mt-1">Ready to begin?</h2>
      <p class="subtitle"><%= pluralize(@quiz.questions.size, "question") %>. Your progress is saved as you move through the quiz.</p>
      <%= render "attempt_rules", quiz: @quiz %>
      <div class="actions mt-5">
        <%= render "connection_check",
          label: "Start quiz",
          destination: attempt_organization_course_quiz_path(current_organization, @course, @quiz) %>
      </div>
    <% else %>
      <p class="eyebrow">Unavailable</p>
      <h2 id="quiz-status-heading" class="mt-1">This quiz is not ready yet</h2>
      <p class="subtitle">There are no questions to attempt.</p>
    <% end %>
  </section>

  <% unless @attempt&.in_progress? %>
    <%= render "organizations/courses/module_navigation",
      previous_course_content: @previous_course_content,
      next_course_content: @next_course_content %>
  <% end %>
<% end %>
