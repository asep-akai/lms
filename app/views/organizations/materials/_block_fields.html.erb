<section class="material-block" data-material-editor-target="block" data-block-type="<%= block.object.block_type %>">
  <%= block.hidden_field :id if block.object.persisted? %>
  <%= block.hidden_field :block_type %>
  <%= block.hidden_field :position, data: { material_editor_target: "position" } %>
  <%= block.hidden_field :_destroy, value: "0", data: { material_editor_target: "destroy" } %>

  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
    <p class="text-sm font-semibold text-slate-700"><%= block.object.block_type.titleize %></p>
    <div class="actions">
      <button type="button" class="btn-secondary" data-action="material-editor#moveUp">Move up</button>
      <button type="button" class="btn-secondary" data-action="material-editor#moveDown">Move down</button>
      <button type="button" class="btn-secondary" data-action="material-editor#remove">Remove</button>
    </div>
  </div>

  <div class="p-4">
    <% if block.object.text? %>
      <div data-controller="rich-text-editor">
        <div class="rich-editor-toolbar" aria-label="Text formatting" data-action="mousedown->rich-text-editor#preserveSelection">
          <div class="rich-editor-group" role="group" aria-label="Text size">
            <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="formatBlock" data-value="h2">Title</button>
            <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="formatBlock" data-value="h3">Heading</button>
            <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="formatBlock" data-value="p">Body</button>
          </div>
          <span class="rich-editor-separator" aria-hidden="true"></span>
          <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="bold" aria-label="Bold"><strong>B</strong></button>
          <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="italic" aria-label="Italic"><em>I</em></button>
          <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="underline" aria-label="Underline"><u>U</u></button>
          <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="insertUnorderedList">Bulleted list</button>
          <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="insertOrderedList">Numbered list</button>
          <span class="rich-editor-separator" aria-hidden="true"></span>
          <div class="rich-editor-group" role="group" aria-label="Text color">
            <button type="button" class="rich-editor-color text-slate-900" data-action="rich-text-editor#format" data-command="foreColor" data-value="#0f172a">Default</button>
            <button type="button" class="rich-editor-color text-red-700" data-action="rich-text-editor#format" data-command="foreColor" data-value="#b91c1c">Red</button>
            <button type="button" class="rich-editor-color text-blue-700" data-action="rich-text-editor#format" data-command="foreColor" data-value="#1d4ed8">Blue</button>
            <button type="button" class="rich-editor-color text-green-700" data-action="rich-text-editor#format" data-command="foreColor" data-value="#15803d">Green</button>
          </div>
        </div>
        <div class="rich-editor" contenteditable="true" role="textbox" aria-label="Material text" aria-multiline="true" data-rich-text-editor-target="editor" data-action="input->rich-text-editor#synchronize"><%= sanitize(block.object.body_html, tags: MaterialBlock::ALLOWED_HTML_TAGS, attributes: MaterialBlock::ALLOWED_HTML_ATTRIBUTES) %></div>
        <%= block.hidden_field :body_html, data: { rich_text_editor_target: "input" } %>
      </div>
    <% elsif block.object.image? %>
      <% if block.object.image.attached? %>
        <div class="mb-4 flex items-center gap-4">
          <%= image_tag block.object.image, alt: "", class: "h-24 w-32 rounded-lg object-cover" %>
          <p class="text-sm text-slate-600">Current image: <%= block.object.image.filename %></p>
        </div>
      <% end %>
      <%= block.label :image, block.object.image.attached? ? "Replace image" : "Choose image", class: "label" %>
      <%= block.file_field :image, accept: Material::ALLOWED_IMAGE_TYPES.join(","), class: "field", required: !block.object.image.attached? %>
      <p class="hint">JPEG, PNG, GIF, or WebP. Maximum 10 MB.</p>
    <% else %>
      <%= block.label :video_url, "YouTube URL", class: "label" %>
      <%= block.url_field :video_url,
        class: "field",
        required: true,
        maxlength: 2_000,
        placeholder: "https://www.youtube.com/watch?v=…" %>
      <p class="hint">Paste a YouTube watch, share, Shorts, or embed link.</p>
    <% end %>
  </div>
</section>
