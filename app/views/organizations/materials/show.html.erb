<div class="page-header">
  <div>
    <p class="eyebrow"><%= @course.name %> · Material</p>
    <h1 class="title"><%= @material.title %></h1>
    <% if @material.description.present? %>
      <p class="subtitle"><%= @material.description %></p>
    <% end %>
  </div>
  <div class="actions">
    <% if params[:from] == "course" %>
      <%= back_link_to "Back to course", organization_course_path(current_organization, @course) %>
    <% else %>
      <%= back_link_to "Back to materials", organization_course_materials_path(current_organization, @course) %>
    <% end %>
    <% if policy(@material).update? %>
      <%= link_to "Edit material", edit_organization_course_material_path(current_organization, @course, @material, from: params[:from]), class: "btn-primary" %>
    <% end %>
  </div>
</div>

<article class="material-article mt-8">
  <% @material.blocks.each do |block| %>
    <% if block.text? %>
      <div class="rich-content text-slate-800"><%= sanitize(block.body_html, tags: MaterialBlock::ALLOWED_HTML_TAGS, attributes: MaterialBlock::ALLOWED_HTML_ATTRIBUTES) %></div>
    <% elsif block.image.attached? %>
      <figure>
        <%= image_tag block.image, alt: block.image.filename.to_s, class: "mx-auto h-auto max-w-full rounded-lg" %>
      </figure>
    <% elsif block.video? %>
      <div class="aspect-video overflow-hidden rounded-lg bg-slate-950">
        <iframe
          src="<%= block.youtube_embed_url %>"
          title="YouTube video: <%= @material.title %>"
          class="h-full w-full"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    <% end %>
  <% end %>
</article>

<% if current_membership&.student? %>
  <%= render "organizations/courses/module_navigation",
    previous_course_content: @previous_course_content,
    next_course_content: @next_course_content,
    material: @material,
    material_completed: @material_completed %>
<% end %>

<% if policy(@material).destroy? %>
  <div class="mt-8">
    <%= button_to "Delete material", organization_course_material_path(current_organization, @course, @material, from: params[:from]), method: :delete, form: { data: { turbo_confirm: "Delete this material and its images?" } }, class: "btn-danger" %>
  </div>
<% end %>
