<div class="page-header">
  <h1 class="title"><%= material.persisted? ? "Edit material" : "New material" %></h1>
  <% back_path = if material.persisted?
    organization_course_material_path(current_organization, @course, material, from: params[:from])
  elsif params[:from] == "course"
    organization_course_path(current_organization, @course)
  else
    organization_course_materials_path(current_organization, @course)
  end %>
  <%= back_link_to material.persisted? ? "Back to material" : (params[:from] == "course" ? "Back to course" : "Back to materials"), back_path %>
</div>

<%= render "shared/errors", record: material %>
<%= form_with model: [ current_organization, @course, material ], class: "form-stack mt-8" do |form| %>
  <%= hidden_field_tag :from, params[:from] if params[:from] == "course" %>
  <div>
    <%= form.label :title, class: "label" %>
    <%= form.text_field :title, required: true, maxlength: 160, autofocus: true, class: "field" %>
  </div>

  <div>
    <%= form.label :description, "Card description", class: "label" %>
    <%= form.text_area :description, maxlength: 500, rows: 3, class: "field" %>
    <p class="hint">Shown on the course content card. It does not appear in the article body.</p>
  </div>

  <div>
    <%= form.label :course_section_id, "Section", class: "label" %>
    <%= form.collection_select :course_section_id, @course.course_sections.ordered, :id, :name, {}, class: "field" %>
    <p class="hint">Choose where this material appears in the course.</p>
  </div>

  <div>
    <%= form.label :cover_image, "Card cover image", class: "label" %>
    <% if material.cover_image.attached? %>
      <div class="mt-2 flex flex-wrap items-center gap-4">
        <%= image_tag material.cover_image, alt: "", class: "h-24 w-32 rounded-lg object-cover" %>
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <%= form.check_box :remove_cover_image, class: "h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-600" %>
          Remove current cover image
        </label>
      </div>
    <% end %>
    <%= form.file_field :cover_image, accept: Material::ALLOWED_IMAGE_TYPES.join(","), class: "field" %>
    <p class="hint">Optional. Shown only on the course card. JPEG, PNG, GIF, or WebP, maximum 10 MB.</p>
  </div>

  <div data-controller="material-editor" data-action="submit->material-editor#synchronize">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2>Article content</h2>
        <p class="hint">Build the material from text, image, and video blocks. Their order here is their reading order.</p>
      </div>
      <div class="actions">
        <button type="button" class="btn-secondary" data-action="material-editor#addText">Add text</button>
        <button type="button" class="btn-secondary" data-action="material-editor#addImage">Add image</button>
        <button type="button" class="btn-secondary" data-action="material-editor#addVideo">Add video</button>
      </div>
    </div>

    <div class="mt-4 space-y-4" data-material-editor-target="blocks">
      <%= form.fields_for :blocks do |block| %>
        <%= render "organizations/materials/block_fields", block: block %>
      <% end %>
    </div>

    <template data-material-editor-target="textTemplate">
      <%= form.fields_for :blocks, MaterialBlock.new(block_type: "text"), child_index: "NEW_BLOCK" do |block| %>
        <%= render "organizations/materials/block_fields", block: block %>
      <% end %>
    </template>
    <template data-material-editor-target="imageTemplate">
      <%= form.fields_for :blocks, MaterialBlock.new(block_type: "image"), child_index: "NEW_BLOCK" do |block| %>
        <%= render "organizations/materials/block_fields", block: block %>
      <% end %>
    </template>
    <template data-material-editor-target="videoTemplate">
      <%= form.fields_for :blocks, MaterialBlock.new(block_type: "video"), child_index: "NEW_BLOCK" do |block| %>
        <%= render "organizations/materials/block_fields", block: block %>
      <% end %>
    </template>
  </div>

  <div class="actions">
    <%= form.submit class: "btn-primary" %>
    <%= link_to "Cancel", back_path, class: "btn-secondary" %>
  </div>
<% end %>
