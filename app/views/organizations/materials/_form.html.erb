<div class="page-header">
  <h1 class="title"><%= material.persisted? ? "Edit material" : "New material" %></h1>
  <%= back_link_to material.persisted? ? "Back to material" : "Back to materials", material.persisted? ? organization_course_material_path(current_organization, @course, material) : organization_course_materials_path(current_organization, @course) %>
</div>

<%= render "shared/errors", record: material %>
<%= form_with model: [ current_organization, @course, material ], class: "form-stack mt-8" do |form| %>
  <div>
    <%= form.label :title, class: "label" %>
    <%= form.text_field :title, required: true, maxlength: 160, autofocus: true, class: "field" %>
  </div>

  <div>
    <%= form.label :body_html, "Text", class: "label" %>
    <div class="mt-2" data-controller="rich-text-editor">
      <div class="rich-editor-toolbar" aria-label="Text formatting" data-action="mousedown->rich-text-editor#preserveSelection">
        <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="bold" aria-label="Bold"><strong>B</strong></button>
        <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="italic" aria-label="Italic"><em>I</em></button>
        <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="underline" aria-label="Underline"><u>U</u></button>
        <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="insertUnorderedList">Bulleted list</button>
        <button type="button" class="rich-editor-button" data-action="rich-text-editor#format" data-command="insertOrderedList">Numbered list</button>
      </div>
      <div class="rich-editor" contenteditable="true" role="textbox" aria-multiline="true" data-rich-text-editor-target="editor" data-action="input->rich-text-editor#synchronize"><%= sanitize(material.body_html, tags: Material::ALLOWED_HTML_TAGS, attributes: []) %></div>
      <%= form.hidden_field :body_html, data: { rich_text_editor_target: "input" } %>
    </div>
  </div>

  <div>
    <%= form.label :images, class: "label" %>
    <%= form.file_field :images, multiple: true, accept: Material::ALLOWED_IMAGE_TYPES.join(","), class: "field" %>
    <p class="hint">JPEG, PNG, GIF, or WebP. Maximum 10 MB per image.</p>
    <% if material.images.attached? %>
      <p class="mt-2 text-sm text-slate-600"><%= pluralize(material.images.size, "existing image") %>. Selecting new images replaces the current set.</p>
    <% end %>
  </div>

  <div class="actions">
    <%= form.submit class: "btn-primary" %>
    <%= link_to "Cancel", material.persisted? ? organization_course_material_path(current_organization, @course, material) : organization_course_materials_path(current_organization, @course), class: "btn-secondary" %>
  </div>
<% end %>
