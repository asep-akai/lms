<div class="page-header">
  <div>
    <p class="eyebrow"><%= @class_meeting.subject %> · Meeting <%= @class_meeting.meeting_number %></p>
    <h1 class="title"><%= @class_meeting.topic %></h1>
    <p class="subtitle"><%= @class_meeting.starts_at.in_time_zone(current_organization.timezone).strftime("%-d %B %Y at %H:%M %Z") %></p>
    <% if @class_meeting.cancelled? %>
      <p class="mt-2"><span class="badge-suspended">Cancelled</span></p>
    <% end %>
  </div>
  <div class="actions">
    <%= back_link_to @back_label, @back_path %>
    <% if policy(@class_meeting).update? %>
      <%= link_to "Edit class",
        edit_organization_class_meeting_path(current_organization, @class_meeting, **@navigation_params),
        class: "btn-primary" %>
    <% end %>
  </div>
</div>

<% if current_membership.student? && @class_meeting.student_memberships.exists?(current_membership.id) && !@class_meeting.cancelled? %>
  <section class="card card-body mt-8" aria-labelledby="reschedule-heading">
    <h2 id="reschedule-heading">Reschedule this class</h2>
    <p class="mt-2 text-sm text-slate-600">You have <strong class="text-slate-950"><%= pluralize(current_membership.reschedule_quota, "reschedule") %></strong> remaining.</p>
    <% if @class_meeting.student_memberships.size > 1 %>
      <p class="mt-3 text-sm text-slate-600">Individual rescheduling is unavailable because this class has multiple students.</p>
    <% elsif Time.current > @class_meeting.starts_at - 24.hours %>
      <p class="mt-3 text-sm text-slate-600">The request window closed 24 hours before the class.</p>
    <% elsif current_membership.reschedule_quota.zero? %>
      <p class="mt-3 text-sm text-slate-600">Ask an organization administrator if you need additional quota.</p>
    <% else %>
      <p class="mt-3 text-sm text-slate-600">This will cancel the scheduled class and notify <%= @class_meeting.teacher_membership.user.name %>. An administrator can arrange the replacement class separately.</p>
      <div class="actions mt-4">
        <%= button_to "Request reschedule",
          request_reschedule_organization_class_meeting_path(current_organization, @class_meeting, **@navigation_params),
          method: :post,
          form: { data: { turbo_confirm: "Use one reschedule quota and cancel this class? The teacher will be notified." } },
          class: "btn-danger" %>
      </div>
    <% end %>
  </section>
<% end %>

<div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]">
  <section class="card card-body" aria-labelledby="class-details-heading">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h2 id="class-details-heading">Meeting details</h2>
      <span class="<%= @class_meeting.online? ? "badge-active" : "badge-neutral" %>"><%= @class_meeting.delivery_mode.humanize %></span>
    </div>
    <dl class="mt-5 grid gap-5 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-slate-500">Subject</dt>
        <dd class="mt-1 text-slate-950"><%= @class_meeting.subject %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500">Meeting number</dt>
        <dd class="mt-1 text-slate-950"><%= @class_meeting.meeting_number %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500">Date and time</dt>
        <dd class="mt-1 text-slate-950"><%= @class_meeting.starts_at.in_time_zone(current_organization.timezone).strftime("%-d %B %Y at %H:%M %Z") %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500">Teacher</dt>
        <dd class="mt-1 text-slate-950"><%= @class_meeting.teacher_membership.user.name %></dd>
      </div>
      <% if @class_meeting.online? %>
        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-slate-500">Online meeting</dt>
          <dd class="mt-2">
            <% if @class_meeting.safe_meeting_url.present? %>
              <%= link_to "Join online class",
                ERB::Util.html_escape(@class_meeting.safe_meeting_url),
                target: "_blank",
                rel: "noopener noreferrer",
                class: "btn-primary" %>
            <% else %>
              <span class="text-sm text-slate-500">No meeting link has been added.</span>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section class="card card-body" aria-labelledby="students-heading">
    <p class="eyebrow"><%= pluralize(@class_meeting.student_memberships.size, "student") %></p>
    <h2 id="students-heading" class="mt-1">Assigned students</h2>
    <ul class="mt-5 space-y-4">
      <% @class_meeting.student_memberships.sort_by { |membership| membership.user.name.downcase }.each do |membership| %>
        <li>
          <strong class="block text-sm text-slate-950"><%= membership.user.name %></strong>
          <span class="text-sm text-slate-500"><%= membership.user.email %></span>
        </li>
      <% end %>
    </ul>
  </section>
</div>

<% if policy(@class_meeting).destroy? %>
  <div class="mt-8">
    <%= button_to "Delete class",
      organization_class_meeting_path(current_organization, @class_meeting, **@navigation_params),
      method: :delete,
      form: { data: { turbo_confirm: "Delete this scheduled class meeting?" } },
      class: "btn-danger" %>
  </div>
<% end %>
