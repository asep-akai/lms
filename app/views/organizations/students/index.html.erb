<div class="page-header">
  <div>
    <h1 class="title">Students</h1>
    <% if current_membership.teacher? && !can?("students.index") %>
      <p class="subtitle">Students assigned to classes you teach.</p>
    <% else %>
      <p class="subtitle">Course enrollment and completion tracking for <%= current_organization.name %>.</p>
    <% end %>
  </div>
  <%= back_link_to "Back to organization", organization_path(current_organization) %>
</div>

<%= render "shared/table_search",
  url: organization_students_path(current_organization),
  query: @query,
  label: "Search students",
  placeholder: "Search by name, email, or status" %>

<% if @students.any? %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th class="th">Student</th>
          <th class="th">Status</th>
          <th class="th">Reschedule quota</th>
          <th class="th">Courses</th>
          <th class="th">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @students.each do |student| %>
          <tr>
            <td class="td">
              <strong><%= student.user.name %></strong><br>
              <%= student.user.email %>
            </td>
            <td class="td"><span class="<%= status_badge_class(student.status) %>"><%= student.status.titleize %></span></td>
            <td class="td"><%= student.reschedule_quota %></td>
            <td class="td"><%= pluralize(student.course_enrollments.size, "course") %></td>
            <td class="td">
              <% if StudentPolicy.new(current_user, student).show? %>
                <div class="actions">
                  <%= link_to "View student", organization_student_path(current_organization, student), class: "btn-secondary" %>
                  <% if current_membership.organization_admin? %>
                    <%= modal_link_to "Edit quota", reschedule_quota_organization_student_path(current_organization, student), class: "btn-secondary" %>
                  <% end %>
                  <% if policy(Assignment.new(organization: current_organization, teacher_membership: current_membership)).create? %>
                    <%= link_to "Give assignment", new_organization_assignment_path(current_organization, student_id: student.id), class: "btn-primary" %>
                  <% end %>
                  <% if can?("course_enrollments.update") && student.active? %>
                    <%= modal_link_to "Enroll in course", enrollment_organization_student_path(current_organization, student), class: "btn-primary" %>
                  <% end %>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <% if @query.present? %>
    <div class="empty-state">No students match “<%= @query %>”. Try another search or clear it.</div>
  <% elsif current_membership.teacher? && !can?("students.index") %>
    <div class="empty-state">No students are assigned to your classes yet.</div>
  <% else %>
    <div class="empty-state">No students have been added yet. Add a user with the Student role from User management.</div>
  <% end %>
<% end %>
<%= render "shared/pagination", pagination: @pagination %>
