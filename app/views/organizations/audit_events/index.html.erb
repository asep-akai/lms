<h1 class="title">Audit log</h1><p class="subtitle">The 100 most recent administrative and security events.</p><div class="table-wrap"><table class="data-table"><thead><tr><th class="th">Time</th><th class="th">Actor</th><th class="th">Action</th><th class="th">Subject</th></tr></thead><tbody><% @audit_events.each do |event| %><tr><td class="td"><%= event.occurred_at.in_time_zone(current_organization.timezone).to_fs(:short) %></td><td class="td"><%= event.actor&.name || "System" %></td><td class="td"><%= event.action.humanize %></td><td class="td"><%= event.auditable ? "#{event.auditable_type} ##{event.auditable_id}" : "—" %></td></tr><% end %></tbody></table></div>
