# Image built from the production Dockerfile. Replace this with a registry image
# such as ghcr.io/your-account/lms:release-tag when deploying from a registry.
LMS_IMAGE=lms:production

# Public hostname and host-only port used between Nginx and the web container.
APP_HOST=lms.example.com
LMS_HTTP_PORT=3001

# Use the key that matches config/credentials.yml.enc; a new random key cannot decrypt it.
RAILS_MASTER_KEY=replace-with-the-real-master-key
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
DATABASE_POOL=5
JOB_CONCURRENCY=1
HSTS_ENABLED=true
HSTS_SUBDOMAINS=false

# PostgreSQL is private to the production Compose network.
# The administrator secret is passed only to the database, never to Rails/jobs.
POSTGRES_ADMIN_USER=lms_bootstrap
POSTGRES_ADMIN_PASSWORD=replace-with-a-different-long-random-admin-password
POSTGRES_USER=lms
LMS_DATABASE_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=lms_production
POSTGRES_CACHE_DB=lms_production_cache
POSTGRES_CABLE_DB=lms_production_cable

# Replace these values with a real transactional SMTP account.
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=lms.example.com
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_SSL=false
MAIL_FROM=noreply@example.com

# AI-assisted grading is unavailable when OPENAI_API_KEY is blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
