LMS_ENV_FILE=/srv/lms/.env.production
LMS_PROJECT=lms-production
LMS_BACKUP_ROOT=/var/lib/lms-backups
LMS_BACKUP_MAX_AGE_HOURS=26
LMS_BACKUP_MIN_FREE_MB=1024
# Configure an off-server repository accepted by restic. Initialize it manually once.
RESTIC_REPOSITORY=replace-with-your-encrypted-backup-repository
RESTIC_PASSWORD_FILE=/etc/lms/restic-password
# Add backend-specific credentials here, never in a committed file.
# Optional endpoint accepting JSON {service, status}; without it failures stay in the journal.
LMS_ALERT_URL=
