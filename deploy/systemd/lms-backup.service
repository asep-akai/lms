[Unit]
Description=LMS encrypted database and attachment backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=lms-ops-alert@%n.service

[Service]
Type=oneshot
User=lmsdeploy
Group=lmsdeploy
WorkingDirectory=/srv/lms
EnvironmentFile=/etc/lms/backup.env
Environment=RESTIC_CACHE_DIR=/var/cache/lms-backup
UMask=0077
ExecStart=/srv/lms/bin/production backup-to-restic
TimeoutStartSec=2h
