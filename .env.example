# Local PostgreSQL connection used by Docker Compose.
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_development_password
POSTGRES_DB=lms_development

# Development email is captured by the Mailpit service.
SMTP_ADDRESS=mailpit
SMTP_PORT=1025

# Leave the API key blank when AI-assisted grading is not needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Accounts created or refreshed by the development seed process.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-development
APP_USER_NAME=Organization Owner
APP_USER_EMAIL=owner@example.com
APP_USER_PASSWORD=change-me-in-development

# Example organization created for local development.
DEFAULT_ORGANIZATION_NAME=Example School
DEFAULT_ORGANIZATION_SLUG=example-school
DEFAULT_ORGANIZATION_LOCALE=en
